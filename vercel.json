{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "www.casinovirtual24hrs.com" }
      ],
      "destination": "https://casinovirtual24hrs.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "casinovirtual24hrs.vercel.app" }
      ],
      "destination": "https://casinovirtual24hrs.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "casinovirtual24hrs-matias-projects-2dbf9656.vercel.app" }
      ],
      "destination": "https://casinovirtual24hrs.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "casinovirtual24hrs-git-main-matias-projects-2dbf9656.vercel.app" }
      ],
      "destination": "https://casinovirtual24hrs.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
